@startuml
skinparam dpi 300

actor "检票人员" as Checker
boundary "检票界面" as UI
control "电子票检票服务" as Ticket
database "数据库" as DB

Checker -> UI : 扫码或姓名+手机号后四位检索
UI -> Ticket : 校验电子票及场次授权
Ticket -> DB : 查询电子票有效性及签到状态
DB --> Ticket : 返回核验结果

alt 票有效且尚未签到
  Ticket --> UI : 展示确认界面（持票人姓名、票种）

  opt 实名演出
    Checker -> Checker : 目视核验有效证件原件
  end

  Checker -> UI : 确认签到
  UI -> Ticket : checkIn(ticketId)
  Ticket -> DB : 原子更新电子票及所属报名状态
  DB --> Ticket : 返回更新结果

  alt 更新成功
    Ticket --> UI : 签到成功
  else 已被其他请求签到
    Ticket --> UI : 提示重复签到及首次签到时间
  end

else 已签到
  Ticket --> UI : 提示重复签到及首次签到时间

else 无效、场次错误或未匹配
  Ticket --> UI : 拒绝签到并显示原因
end

@enduml
