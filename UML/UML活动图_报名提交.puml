@startuml
skinparam dpi 300
start
:参与者选择场次、票种与数量;
:填写报名人及逐张持票人信息;
:提交报名请求;
:初步校验身份、活动状态、截止时间和限购;

if (满足报名条件?) then (是)
  :开启事务;
  :按 ticketTypeId 升序锁定相关票种;
  :重新校验报名条件、名额及候补优先权;

  if (报名条件仍然有效?) then (是)
    if (整单名额可分配?) then (是)
      :创建已报名记录及有效电子票;
      :原子占用名额并提交事务;
      :返回报名成功及二维码;
    else (否)
      if (候补入口仍开放?) then (是)
        if (距开场2至2.5小时?) then (是)
          if (已确认候补风险?) then (是)
            :建立候补记录与待出票票级记录;
            :提交事务;
            :返回候补状态;
          else (否)
            :回滚事务;
            :提示无新递补通知机会;
            :请求用户在事务外二次确认并重新提交;
          endif
        else (否)
          :建立候补记录与待出票票级记录;
          :提交事务;
          :返回候补状态;
        endif
      else (否)
        :回滚事务;
        :拒绝报名并说明原因;
      endif
    endif
  else (否)
    :回滚事务;
    :返回最新校验失败原因;
  endif

else (否)
  :返回校验失败原因;
endif

stop
@enduml
